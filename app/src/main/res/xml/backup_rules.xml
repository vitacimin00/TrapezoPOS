<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy (API <= 30) cloud/auto backup rules.

  Trapezo POS is an offline-first POS: its local database IS the business record of truth,
  containing sales, payments, refunds, shifts, customers and audit logs. None of it may leave
  the device through Android's generic backup transport.

  android:allowBackup="false" already disables this, but these rules are declared explicitly so
  the exclusion does not depend on that single attribute.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />

    <!-- Device-protected storage equivalents. -->
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />

    <!-- Cache is not authoritative data and is never backed up. -->
    <exclude domain="external" path="." />
</full-backup-content>
